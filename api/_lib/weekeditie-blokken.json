  "themas": [
    "nacht",
    "goud",
    "licht",
    "data"
  ],
  "hero_varianten": [
    "video-poort",
    "foto",
    "groot-getal",
    "chart"
  ],
  "accountgroottes": [
    10000,
    25000,
    50000,
    100000,
    200000,
    400000
  ],
  "interactief": [
    "replay-sweep-bos",
    "fib-animatie",
    "trechter",
    "rr-sliders",
