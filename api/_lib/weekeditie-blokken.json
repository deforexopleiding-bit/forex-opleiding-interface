  "regels": [
    "Precies 1 hero, als eerste blok.",
    "Minstens 2 interactieve blokken (replay-sweep-bos, fib-animatie, trechter, rr-sliders, funded-calculator, quiz).",
    "Minstens 1 nugget (payout-muur, data, tip, mythe-feit).",
    "Precies 1 cadeau-blok.",
    "Met video: precies 1 poort (hero-variant video-poort óf een video-poort-blok), geen inschrijven-blok.",
    "Zonder video: precies 1 inschrijven-blok, geen video-poort (ook niet als hero-variant).",
    "Elk bloktype hoogstens 1 keer, behalve data, citaat en verhaal (max 2).",
    "Tussen 6 en 14 blokken."
  ],
  "blokken": [
    {
      "type": "hero",
      "categorie": "opening",
      "uitleg": "De opening. video-poort = kop + poort naast elkaar (enkel met video); foto = masterclassfoto full-bleed; groot-getal = één echt cijfer dat optelt; chart = chart die zich tekent.",
      "beweging": "tekent/telt bij laden",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "hero"
          },
          "variant": {
            "type": "string",
            "enum": [
              "video-poort",
              "foto",
              "groot-getal",
              "chart"
            ]
          },
          "props": {
            "type": "object",
            "properties": {
              "eyebrow": {
                "description": "Klein goud label boven de kop (hoofdletters, met lijn), max ±5 woorden.",
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "titel": {
                "description": "Hoofdkop van de editie (max ±9 woorden); het deel tussen **…** wordt goud.",
                "type": "string",
                "minLength": 1,
                "maxLength": 110
              },
              "intro": {
                "description": "2-3 zinnen; **vet** voor de kern.",
                "type": "string",
                "minLength": 1,
                "maxLength": 420
              },
              "feiten": {
                "description": "Max 3 korte feit-chips (bv. \"35 min analyse\").",
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "foto_asset_id": {
                "description": "Enkel bij variant foto: masterclass- of teamfoto (full-bleed met gradient).",
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "getal": {
                "description": "Enkel bij variant groot-getal: het ene grote cijfer dat optelt.",
                "type": "object",
                "properties": {
                  "waarde": {
                    "description": "Het echte cijfer (uit de feitenbank of de invoer van de week).",
                    "type": "number"
                  },
                  "decimalen": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "prefix": {
                    "description": "bv. \"$\", \"€\", \"+\"",
                    "type": "string",
                    "maxLength": 4
                  },
                  "suffix": {
                    "description": "bv. \"%\", \"R\", \" trades\"",
                    "type": "string",
                    "maxLength": 12
                  },
                  "label": {
                    "description": "Wat het cijfer is, kort.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "context": {
                    "description": "Eén zin context of nuance.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  },
                  "bron": {
                    "description": "Waar het cijfer vandaan komt (feitenbank-regel).",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "waarde",
                  "label",
                  "bron"
                ],
                "additionalProperties": false
              },
              "chart_richting": {
                "description": "Enkel bij variant chart: richting van de chart die zich tekent.",
                "type": "string",
                "enum": [
                  "long",
                  "short"
                ]
              },
              "chart_label": {
                "description": "Enkel bij variant chart: label op de chart, bv. \"GBP/USD · H4\".",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "titel",
              "intro"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "variant",
          "props"
        ],
        "additionalProperties": false
      }
    },
