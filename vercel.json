{
  "functions": {
    "api/cron-finance-sync.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/**/*.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/sync-emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/backfill-emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/standup-weekly",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/agent-expire-approvals",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/backfill-bodies",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/follow-up-ghl-appointment-poll",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/follow-up-ghl-conversations-poll",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/follow-up-admin-daily",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/follow-up-admin-weekly",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron-lisa-delayed",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-finance-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-bank-sync",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron-dunning-engine",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-incasso-auto",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron-dunning-promise-maturity",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron-dunning-conv-less-resume",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/cron-arrangements-breach-check",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-event-belronde",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron-cancellation-cleanup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/joost-outbound-scheduler",
      "schedule": "30 8,11,14,17 * * 1-5"
    },
    {
      "path": "/api/cron-events-sync-retry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-events-ghl-next-update",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-events-signups-auto-close",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-events-cms-cleanup",
      "schedule": "5 1 * * *"
    },
    {
      "path": "/api/cron-events-auto-archive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-events-close-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron-dunning-bulk-send",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/cron-dunning-conversation-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-events-automations",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-meta-ads-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron-meta-ads-alerts",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron-meta-capi",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/generate-monthly-concepts",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/archive-completed-onboardings",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/onboarding-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/onboarding-automations",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/noshow-detect",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/future-call-reminder",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/first-call-payment-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-candles",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-mentor-cash-release",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-activity-log-cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/snapshot-cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron-leadsonderhoud",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-toegang-aanvragen",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron-setter-cash-release",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-lisa-conversations-poll",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api).*)",
      "has": [
        { "type": "host", "value": "forex-opleiding-interface.vercel.app" }
      ],
      "destination": "https://crm.deforexopleiding.nl/$1",
      "permanent": false
    },
    {
      "source": "/modules/klanten.html",
      "destination": "/modules/klanten-v2/",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "destination": "/modules/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/display", "destination": "/display.html" },
    { "source": "/tv",      "destination": "/api/tv" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security",  "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options",            "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",     "value": "nosniff" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",         "value": "camera=(), microphone=(self), geolocation=(), payment=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.teamleader.eu https://focus.teamleader.eu https://api.anthropic.com https://services.leadconnectorhq.com https://rest.gohighlevel.com https://voys.nl https://cdr.voipgrid.nl https://freddy-api.voipgrid.nl wss://freddy-ws.voipgrid.nl wss://websocket.voipgrid.nl; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" }
      ]
    }
  ]
}
