# services/whatsapp-brug/.env.example
#
# Kopieer naar .env op de VPS en vul in. Zet `chmod 600 .env` — hier staat een
# geheim in waarmee je de leadlijst kunt opvragen.

# ── Waar de brug naar luistert ──────────────────────────────────────────────
PORT=8088
# Bind standaard op localhost. Zet dit alleen op 0.0.0.0 als de firewall het
# afdekt; anders staat je WhatsApp-brug open op het internet.
BIND=127.0.0.1

# ── Het gedeelde geheim ─────────────────────────────────────────────────────
# Zelfde waarde als WHATSAPP_BRUG_SECRET in Vercel. Genereer met:
#   openssl rand -hex 32
BRUG_SECRET=

# Optionele IP-allowlist, komma-gescheiden. Leeg = geen IP-check (dan doet
# alleen het geheim het werk). Vul hier de uitgaande IP's van Vercel in als je
# die vastzet, of het IP van je reverse proxy.
ALLOWED_IPS=

# ── Het CRM ─────────────────────────────────────────────────────────────────
CRM_BASE_URL=https://forex-opleiding-interface.vercel.app
# Waar de brug de gebeurtenissen heen duwt.
CRM_WEBHOOK_PATH=/api/opvolging-whatsapp-webhook
# Waar de brug elke vijf minuten de lijst met bekende leadnummers ophaalt.
CRM_NUMMERS_PATH=/api/opvolging-whatsapp-nummers
# Hoe vaak die lijst ververst wordt, in seconden.
NUMMERS_INTERVAL_SEC=300

# ── Waar de sessie op schijf staat ──────────────────────────────────────────
# LocalAuth bewaart hier de ingelogde sessie. Deze map NIET weggooien: dan
# moet er opnieuw een QR gescand worden.
SESSIE_PAD=./.wwebjs_auth

# ── Chromium ────────────────────────────────────────────────────────────────
# Laat leeg om de meegeleverde Chromium van puppeteer te gebruiken. Op een
# kale VPS is de systeem-Chromium vaak stabieler:
#   CHROMIUM_PAD=/usr/bin/chromium-browser
CHROMIUM_PAD=
